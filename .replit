modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "LitigaForge AI"

[[workflows.workflow]]
name = "LitigaForge AI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/litigaforge-ai && PORT=5000 python main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 23790
externalPort = 3001

[userenv]

[userenv.shared]
API_SETU_KEY = "demokey123456ABCD789"
API_SETU_CLIENT_ID = "in.gov.sandbox"
MEESEVA_USE_PROD = "false"
BASE_PATH = "/litigaforge"
PORT = "5000"
ECOURTS_API_KEY = "eci_live_7v153fk43vv5hf3bhlh6xst9x82e5lgy"

[nix]
channel = "stable-25_05"
