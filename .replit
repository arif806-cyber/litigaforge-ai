modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 23790
externalPort = 3001

[[ports]]
localPort = 24337
externalPort = 3002

[[ports]]
localPort = 24347
externalPort = 6000

[userenv]

[userenv.shared]
MEESEVA_USE_PROD = "false"
BASE_PATH = "/litigaforge"
PORT = "5000"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
ADMIN_EMAILS = "arif.806@gmail.com"
SMTP_USER = "arif.806@gmail.com"
INDEXNOW_KEY = "5a4662dfa9b58713797b87f6d724876f"

[userenv.development]

[nix]
channel = "stable-25_05"
