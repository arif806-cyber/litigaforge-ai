# ═══════════════════════════════════════════════════════════════════════════════
# LitigaForge AI — Environment Variables (.env)
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# ═══════════════════════════════════════════════════════════════════════════════


# ── Database ─────────────────────────────────────────────────────────────────
# Strong random password for PostgreSQL. Change before first deploy.
# Generate with: openssl rand -hex 24
DB_PASSWORD=change-this-strong-db-password-here


# ── Session / JWT Secret ─────────────────────────────────────────────────────
# Random 64-char hex string used to sign JWT tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-64char-random-hex-string-generated-with-openssl


# ── AI Provider Keys ─────────────────────────────────────────────────────────
# At least ONE key is required for AI features to work.
# The engine falls back through Claude → GPT-4o → Gemini.

# Anthropic Claude (recommended primary - best legal reasoning)
# Get free credits at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# OpenAI GPT-4o (fallback)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR-KEY-HERE

# Google Gemini 2.5 Flash (entity extraction + tertiary fallback)
# Free tier available at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy-YOUR-KEY-HERE


# ── Optional: WhatsApp/SMS Alerts via Twilio ─────────────────────────────────
# Leave blank to disable hearing reminders
# Sign up at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
